// Frame header schema shared by C and Go for TCP stream framing.
proto frameheader;

enum PayloadType : uint5 {
    PAYLOAD_TYPE_UNKNOWN = 0;
    PAYLOAD_TYPE_DRONE = 1;
}

enum ProtocolVersion : uint3 {
    PROTOCOL_VERSION_UNKNOWN = 0;
    PROTOCOL_VERSION_V1 = 1;
}

message FrameHeader {
    uint8 magic = 1;
    ProtocolVersion version = 2;
    PayloadType payload_type = 3;
    uint16 payload_length = 4;
}
